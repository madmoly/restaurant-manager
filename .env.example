# restaurant-manager — 환경변수 예시
# 실제 값은 .env 에 작성 (.gitignore 에 포함됨)

# Core
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database (MySQL)
# 로컬:     mysql://rmuser:rmpass@localhost:3306/restaurant_manager
# 클라우드: mysql://USER:PASS@HOST:3306/DB
DATABASE_URL=mysql://USER:PASS@HOST:3306/DATABASE

# Auth
# 생성: openssl rand -base64 48
JWT_SECRET=change-me-to-random-48-bytes

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Upstage (Document Parse OCR)
UPSTAGE_API_KEY=
# OCR 엔진 선택: upstage (Upstage+Claude 하이브리드) | claude_vision (기존 Claude Vision 단독)
OCR_ENGINE=claude_vision

# Google Drive (Service Account)
# server/gdrive.ts 가 JSON.parse() 로 읽음 → JSON 문자열 그대로 주입
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# SMTP (nodemailer, Gmail 고정)
# Gmail 2FA 사용 시 앱 비밀번호 필요: https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
