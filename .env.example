# =============================================================================
# restaurant-manager | Environment Variables
# 이 파일을 .env로 복사한 후 값을 채워 사용
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database ---
# docker compose 사용 시: mysql://rmuser:rmpass@localhost:3306/restaurant_manager
# Railway 사용 시: Railway MySQL 플러그인이 자동 주입
DATABASE_URL=mysql://rmuser:rmpass@localhost:3306/restaurant_manager

# --- Auth ---
# JWT 서명용 시크릿 (최소 32자 랜덤 문자열)
# 생성: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# --- Storage (S3 호환) ---
# Manus Forge 대체 → AWS S3 직접 연결
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# S3_BUCKET_NAME=restaurant-manager-uploads

# --- LLM (선택) ---
# Manus Forge 대체 → OpenAI 직접 연결
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Manus 레거시 (독립 배포 시 제거 대상) ---
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# --- Docker Compose MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=restaurant_manager
MYSQL_USER=rmuser
MYSQL_PASSWORD=rmpass
